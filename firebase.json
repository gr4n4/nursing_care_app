{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nursing-care-app-702b7",
          "appId": "1:616337186483:android:d8d33a1f02fff019965ac6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nursing-care-app-702b7",
          "configurations": {
            "android": "1:616337186483:android:d8d33a1f02fff019965ac6",
            "ios": "1:616337186483:ios:da0c7f2fd09e9326965ac6",
            "macos": "1:616337186483:ios:da0c7f2fd09e9326965ac6",
            "web": "1:616337186483:web:d18da56f0dfd5828965ac6",
            "windows": "1:616337186483:web:d42632af4f36d02f965ac6"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "앱 코드 파일들은 이름에 해시가 없어서(main.dart.js 등) 오래 캐시하면 배포해도 옛 버전이 계속 돈다. no-cache는 '저장하지 말라'가 아니라 '쓰기 전에 서버에 확인하라'는 뜻이라, 안 바뀐 파일은 304로 끝나 비용도 거의 없다.",
        "source": "/@(index.html|flutter_bootstrap.js|flutter.js|main.dart.js|flutter_service_worker.js|firebase-messaging-sw.js|manifest.json|version.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "//": "폰트·아이콘·캔버스킷 같은 정적 자산은 잘 안 바뀌므로 길게 캐시한다.",
        "source": "**/@(assets|canvaskit|icons)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}